{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protective-gear-site",
  "main": "worker.mjs",
  // Matches what the dashboard already provisioned. Wrangler overwrites the
  // remote config on every deploy, so anything set in the dashboard must be
  // mirrored here or it is silently dropped.
  "compatibility_date": "2026-08-19",

  // Keeps the *.workers.dev URL alive for testing before DNS is switched.
  "workers_dev": true,

  // The wildcard matters. The dashboard's route was "arkhygienesolutions.com/"
  // — the bare root — so only the homepage reached the Worker while every
  // /_astro/* asset fell through to the old origin, which no longer has those
  // content-hashed filenames. The result was a 404 on the stylesheet and an
  // unstyled live site. /* keeps the whole origin on one host.
  //
  // No www route: that hostname has no DNS record.
  "routes": [
    {
      "pattern": "arkhygienesolutions.com/*",
      "zone_name": "arkhygienesolutions.com"
    }
  ],

  // The Astro build output is served as static assets; the Worker in
  // worker.mjs only intercepts /api/*. _redirects and _headers in dist/ are
  // honoured by the assets runtime, so the same files cover Cloudflare and
  // Netlify.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
