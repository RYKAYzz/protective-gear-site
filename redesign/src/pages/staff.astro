---
import "@fontsource-variable/source-sans-3";
import "../styles/tokens.css";
import { categories } from "../data/categories.js";

const categoryOptions = categories.map((c) => ({
  slug: c.slug,
  name: c.name,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Staff admin — ARK Hygiene Solutions</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <!-- ===================== Login ===================== -->
    <div id="login" class="login">
      <form class="login__card" id="login-form">
        <header class="login__head">
          <span class="login__mark">ARK</span>
          <span class="login__brand">
            <span class="login__brand-name">ARK Hygiene Solutions</span>
            <span class="login__brand-sub">Catalogue management</span>
          </span>
        </header>

        <h1 class="login__title">Sign in</h1>
        <p class="login__intro">
          Enter the staff password to update products, prices and details.
        </p>

        <div class="login__field">
          <label for="pw">Password</label>
          <input
            id="pw"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••••••"
            required
            autofocus
          />
        </div>

        <p class="login__error" id="login-error" role="alert" hidden></p>

        <button type="submit" class="btn btn--primary login__btn" id="login-btn">
          Log in
        </button>

        <footer class="login__foot">
          <a href="/" class="login__back">&larr; Back to site</a>
          <span class="login__note">Changes go live in about a minute</span>
        </footer>
      </form>
    </div>

    <!-- ===================== App ===================== -->
    <div id="app" hidden>
      <header class="bar">
        <div class="bar__left">
          <span class="bar__mark">ARK</span>
          <span class="bar__title">Catalogue</span>
          <span class="bar__count" id="count"></span>
        </div>
        <div class="bar__right">
          <span class="bar__status" id="status"></span>
          <button class="btn btn--ghost" id="add">+ Add product</button>
          <button class="btn btn--primary" id="save" disabled>
            Save changes
          </button>
          <button class="btn btn--ghost" id="logout">Log out</button>
        </div>
      </header>

      <div class="toolbar">
        <input
          type="search"
          id="search"
          placeholder="Search products…"
          autocomplete="off"
        />
        <select id="filter">
          <option value="">All categories</option>
          {
            categoryOptions.map((c) => (
              <option value={c.slug}>{c.name}</option>
            ))
          }
        </select>
      </div>

      <main class="list" id="list"></main>
    </div>

    {/* Categories come from the same source the site builds from, so the
        dropdown can never drift out of sync with the real category slugs. */}
    <script is:inline define:vars={{ categoryOptions }}>
      window.__CATEGORIES__ = categoryOptions;
    </script>
    <script is:inline src="/staff.js"></script>

    <style is:global>
      body {
        background: var(--surface);
      }

      /* ---------------- Login ---------------- */
      .login {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: var(--space-m);
        /* a faint warm wash so the card reads as a surface, not a floating box */
        background:
          radial-gradient(
            60rem 40rem at 50% -10%,
            var(--gold-050) 0%,
            transparent 70%
          ),
          var(--surface);
      }

      .login__card {
        width: 100%;
        max-width: 420px;
        padding: var(--space-xl);
        background: var(--paper);
        border: 1px solid var(--line);
        /* tighter than --radius-lg: this should read as a document, not a widget */
        border-radius: 10px;
        box-shadow: var(--shadow-lift);
      }

      @media (min-width: 480px) {
        .login__card {
          padding: var(--space-2xl) var(--space-xl);
        }
      }

      .login__head {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        padding-bottom: var(--space-l);
        margin-bottom: var(--space-l);
        border-bottom: 1px solid var(--line-soft);
      }

      .login__mark {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: var(--radius);
        background: var(--oxblood-700);
        color: var(--gold-050);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
      }

      .login__brand {
        display: grid;
        gap: 1px;
        min-width: 0;
      }

      .login__brand-name {
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .login__brand-sub {
        font-size: var(--step--1);
        color: var(--muted);
      }

      .login__title {
        font-size: var(--step-3);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }

      .login__intro {
        margin-top: var(--space-2xs);
        font-size: var(--step--1);
        color: var(--muted);
        max-width: 34ch;
      }

      .login__field {
        display: grid;
        gap: var(--space-3xs);
        margin-top: var(--space-l);
      }

      .login__field label,
      .field label {
        font-size: var(--step--1);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* This input sits outside .field, so it needs its own rules — without
         them the browser default shows through, which looked unfinished. */
      .login__field input {
        font-family: inherit;
        font-size: var(--step-0);
        color: var(--ink);
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 0.75rem 0.85rem;
        width: 100%;
        transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
      }

      .login__field input::placeholder {
        color: var(--muted-light);
        letter-spacing: 0.1em;
      }

      .login__field input:focus {
        outline: none;
        border-color: var(--oxblood-700);
        box-shadow: 0 0 0 3px var(--oxblood-050);
      }

      .login__error {
        margin: var(--space-s) 0 0;
        padding: var(--space-2xs) var(--space-xs);
        font-size: var(--step--1);
        color: var(--oxblood-800);
        background: var(--oxblood-050);
        border-radius: var(--radius-sm);
      }

      .login__btn {
        width: 100%;
        margin-top: var(--space-m);
      }

      .login__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2xs);
        margin-top: var(--space-l);
        padding-top: var(--space-m);
        border-top: 1px solid var(--line-soft);
        font-size: var(--step--1);
      }

      .login__back {
        color: var(--muted);
      }

      .login__back:hover {
        color: var(--oxblood-700);
      }

      .login__note {
        color: var(--muted-light);
      }

      /* ---------------- Bar ---------------- */
      .bar {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
        padding: var(--space-s) var(--space-m);
        background: var(--paper);
        border-bottom: 1px solid var(--line);
      }

      .bar__left,
      .bar__right {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        flex-wrap: wrap;
      }

      .bar__mark {
        font-weight: 700;
        color: var(--oxblood-700);
        letter-spacing: 0.04em;
      }

      .bar__title {
        font-weight: 600;
      }

      .bar__count,
      .bar__status {
        font-size: var(--step--1);
        color: var(--muted);
      }

      .bar__status[data-tone="ok"] {
        color: #2f6f4f;
      }
      .bar__status[data-tone="err"] {
        color: var(--oxblood-600);
      }

      /* ---------------- Toolbar ---------------- */
      .toolbar {
        display: flex;
        gap: var(--space-s);
        padding: var(--space-m) var(--space-m) 0;
        max-width: 1100px;
        margin-inline: auto;
      }

      .toolbar input,
      .toolbar select {
        font-family: inherit;
        font-size: var(--step-0);
        padding: 0.6rem 0.8rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        background: var(--paper);
        color: var(--ink);
      }

      .toolbar input {
        flex: 1;
      }

      /* ---------------- List ---------------- */
      .list {
        max-width: 1100px;
        margin-inline: auto;
        padding: var(--space-m) var(--space-m) var(--space-3xl);
        display: grid;
        gap: var(--space-2xs);
      }

      .row {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
      }

      .row[data-dirty="true"] {
        border-color: var(--gold-500);
      }

      .row__head {
        display: grid;
        grid-template-columns: 48px 1fr auto auto;
        align-items: center;
        gap: var(--space-s);
        padding: var(--space-2xs) var(--space-s);
        cursor: pointer;
        width: 100%;
        background: none;
        border: 0;
        text-align: left;
        font: inherit;
        color: inherit;
      }

      .row__thumb {
        width: 44px;
        height: 44px;
        object-fit: contain;
        background: var(--white);
        border: 1px solid var(--line-soft);
        border-radius: var(--radius-sm);
        mix-blend-mode: multiply;
      }

      .row__name {
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .row__meta {
        font-size: var(--step--1);
        color: var(--muted);
      }

      .row__price {
        font-size: var(--step--1);
        color: var(--oxblood-700);
        font-variant-numeric: tabular-nums;
      }

      .row__chev {
        color: var(--muted);
        transition: transform 0.2s var(--ease);
      }

      .row[data-open="true"] .row__chev {
        transform: rotate(90deg);
      }

      .row__body {
        padding: var(--space-s) var(--space-s) var(--space-m);
        border-top: 1px solid var(--line-soft);
        display: grid;
        gap: var(--space-s);
      }

      .grid2 {
        display: grid;
        gap: var(--space-s);
      }

      @media (min-width: 700px) {
        .grid2 {
          grid-template-columns: 1fr 1fr;
        }
      }

      .field {
        display: grid;
        gap: var(--space-3xs);
      }

      .field input,
      .field select,
      .field textarea {
        font-family: inherit;
        font-size: var(--step-0);
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        background: var(--white);
        color: var(--ink);
        width: 100%;
      }

      .field textarea {
        resize: vertical;
        line-height: 1.5;
      }

      .field input:focus,
      .field select:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--oxblood-700);
        box-shadow: 0 0 0 3px var(--oxblood-050);
      }

      .row__actions {
        display: flex;
        justify-content: flex-end;
      }

      .btn--ghost {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--ink);
        font-size: var(--step--1);
        padding: 0.55em 0.9em;
      }

      .btn--ghost:hover {
        border-color: var(--ink);
      }

      .btn--danger {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--oxblood-600);
        font-size: var(--step--1);
        padding: 0.55em 0.9em;
      }

      .btn--danger:hover {
        border-color: var(--oxblood-600);
        background: var(--oxblood-050);
      }

      .btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      .empty {
        padding: var(--space-2xl);
        text-align: center;
        color: var(--muted);
      }
    </style>
  </body>
</html>
