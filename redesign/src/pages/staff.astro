---
import "@fontsource-variable/source-sans-3";
import "../styles/tokens.css";
import { categories } from "../data/categories.js";

const categoryOptions = categories.map((c) => ({ slug: c.slug, name: c.name }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Staff admin — ARK Hygiene Solutions</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body>
    <!-- ===================== Login ===================== -->
    <div id="login" class="login">
      <form class="login__card" id="login-form">
        <header class="login__head">
          <span class="login__mark">ARK</span>
          <span class="login__brand">
            <span class="login__brand-name">ARK Hygiene Solutions</span>
            <span class="login__brand-sub">Catalogue management</span>
          </span>
        </header>

        <h1 class="login__title">Sign in</h1>
        <p class="login__intro">
          Enter the staff password to update products, prices and details.
        </p>

        <div class="login__field">
          <label for="pw">Password</label>
          <input
            id="pw"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••••••"
            required
            autofocus
          />
        </div>

        <p class="login__error" id="login-error" role="alert" hidden></p>

        <button type="submit" class="btn btn--primary login__btn" id="login-btn">
          Log in
        </button>

        <footer class="login__foot">
          <a href="/" class="login__back">&larr; Back to site</a>
          <span class="login__note">Changes go live in about a minute</span>
        </footer>
      </form>
    </div>

    <!-- ===================== App ===================== -->
    <div id="app" hidden>
      <header class="bar">
        <div class="bar__left">
          <span class="bar__mark">ARK</span>
          <span class="bar__title">Catalogue</span>
          <span class="bar__count" id="count"></span>
        </div>
        <div class="bar__right">
          <span class="bar__status" id="status"></span>
          <button class="btn btn--ghost" id="add">+ Add product</button>
          <button class="btn btn--primary" id="save" disabled>
            Save changes
          </button>
          <button class="btn btn--ghost" id="logout">Log out</button>
        </div>
      </header>

      <div class="toolbar">
        <input
          type="search"
          id="search"
          placeholder="Search products…"
          autocomplete="off"
        />
        <select id="filter">
          <option value="">All categories</option>
          {categoryOptions.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
      </div>

      <main class="grid" id="grid"></main>
    </div>

    <!-- ===================== Editor ===================== -->
    <div id="editor" class="editor" hidden>
      <div class="editor__scrim" data-act="close"></div>
      <section
        class="editor__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="editor-title"
      >
        <header class="editor__head">
          <h2 class="editor__title" id="editor-title">Edit product</h2>
          <button class="editor__close" data-act="close" aria-label="Close">
            &times;
          </button>
        </header>
        <div class="editor__body" id="editor-body"></div>
        <footer class="editor__foot">
          <button class="btn btn--danger" data-act="delete">Delete</button>
          <button class="btn btn--primary" data-act="close">Done</button>
        </footer>
      </section>
    </div>

    <script is:inline define:vars={{ categoryOptions }}>
      window.__CATEGORIES__ = categoryOptions;
    </script>
    <script is:inline src="/staff.js"></script>

    <style is:global>
      /* The browser's [hidden] rule is display:none at UA specificity, which
         any class selector beats. Force it, or panels that set their own
         display value never hide. */
      [hidden] {
        display: none !important;
      }

      body {
        background: var(--surface);
      }

      /* ---------------- Login ---------------- */
      .login {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: var(--space-m);
        background:
          radial-gradient(
            60rem 40rem at 50% -10%,
            var(--gold-050) 0%,
            transparent 70%
          ),
          var(--surface);
      }

      .login__card {
        width: 100%;
        max-width: 420px;
        padding: var(--space-xl);
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: var(--shadow-lift);
      }

      @media (min-width: 480px) {
        .login__card {
          padding: var(--space-2xl) var(--space-xl);
        }
      }

      .login__head {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        padding-bottom: var(--space-l);
        margin-bottom: var(--space-l);
        border-bottom: 1px solid var(--line-soft);
      }

      .login__mark,
      .bar__mark {
        display: grid;
        place-items: center;
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: var(--radius);
        background: var(--oxblood-700);
        color: var(--gold-050);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
      }

      .login__brand {
        display: grid;
        gap: 1px;
        min-width: 0;
      }

      .login__brand-name {
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .login__brand-sub {
        font-size: var(--step--1);
        color: var(--muted);
      }

      .login__title {
        font-size: var(--step-3);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }

      .login__intro {
        margin-top: var(--space-2xs);
        font-size: var(--step--1);
        color: var(--muted);
        max-width: 34ch;
      }

      .login__field {
        display: grid;
        gap: var(--space-3xs);
        margin-top: var(--space-l);
      }

      .login__field label,
      .field label {
        font-size: var(--step--1);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .login__field input {
        font-family: inherit;
        font-size: var(--step-0);
        color: var(--ink);
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 0.75rem 0.85rem;
        width: 100%;
        transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
      }

      .login__field input::placeholder {
        color: var(--muted-light);
        letter-spacing: 0.1em;
      }

      .login__field input:focus {
        outline: none;
        border-color: var(--oxblood-700);
        box-shadow: 0 0 0 3px var(--oxblood-050);
      }

      .login__error {
        margin: var(--space-s) 0 0;
        padding: var(--space-2xs) var(--space-xs);
        font-size: var(--step--1);
        color: var(--oxblood-800);
        background: var(--oxblood-050);
        border-radius: var(--radius-sm);
      }

      .login__btn {
        width: 100%;
        margin-top: var(--space-m);
      }

      .login__foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2xs);
        margin-top: var(--space-l);
        padding-top: var(--space-m);
        border-top: 1px solid var(--line-soft);
        font-size: var(--step--1);
      }

      .login__back {
        color: var(--muted);
      }
      .login__back:hover {
        color: var(--oxblood-700);
      }
      .login__note {
        color: var(--muted-light);
      }

      /* ---------------- Bar ---------------- */
      .bar {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
        padding: var(--space-2xs) var(--space-m);
        background: var(--paper);
        border-bottom: 1px solid var(--line);
      }

      .bar__left,
      .bar__right {
        display: flex;
        align-items: center;
        gap: var(--space-s);
        flex-wrap: wrap;
      }

      .bar__title {
        font-weight: 600;
      }

      .bar__count,
      .bar__status {
        font-size: var(--step--1);
        color: var(--muted);
      }

      .bar__status[data-tone="ok"] {
        color: #2f6f4f;
      }
      .bar__status[data-tone="err"] {
        color: var(--oxblood-600);
      }

      /* ---------------- Toolbar ---------------- */
      .toolbar {
        display: flex;
        gap: var(--space-s);
        padding: var(--space-m) var(--space-m) 0;
        max-width: 1240px;
        margin-inline: auto;
      }

      .toolbar input,
      .toolbar select {
        font-family: inherit;
        font-size: var(--step-0);
        padding: 0.6rem 0.8rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        background: var(--paper);
        color: var(--ink);
      }

      .toolbar input {
        flex: 1;
      }

      /* ---------------- Card grid ---------------- */
      .grid {
        max-width: 1240px;
        margin-inline: auto;
        padding: var(--space-m) var(--space-m) var(--space-3xl);
        display: grid;
        gap: var(--space-m);
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      }

      .card {
        display: grid;
        grid-template-rows: auto 1fr;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        text-align: left;
        font: inherit;
        color: inherit;
        cursor: pointer;
        transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
      }

      .card:hover {
        border-color: var(--gold-500);
        transform: translateY(-2px);
      }

      .card[data-dirty="true"] {
        border-color: var(--gold-500);
        box-shadow: inset 3px 0 0 var(--gold-500);
      }

      .card__media {
        height: 150px;
        display: grid;
        place-items: center;
        padding: var(--space-s);
        background: var(--white);
        border-bottom: 1px solid var(--line-soft);
      }

      .card__media img {
        max-width: 100%;
        max-height: 118px;
        object-fit: contain;
        mix-blend-mode: multiply;
      }

      .card__media--empty {
        font-size: var(--step--1);
        color: var(--muted-light);
      }

      .card__body {
        padding: var(--space-s);
        display: grid;
        gap: 2px;
        align-content: start;
      }

      .card__name {
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.25;
      }

      .card__cat {
        font-size: var(--step--1);
        color: var(--muted);
      }

      .card__price {
        margin-top: var(--space-3xs);
        font-size: var(--step--1);
        font-weight: 600;
        color: var(--oxblood-700);
        font-variant-numeric: tabular-nums;
      }

      .card__price--none {
        font-weight: 400;
        color: var(--muted-light);
      }

      .empty {
        grid-column: 1 / -1;
        padding: var(--space-2xl);
        text-align: center;
        color: var(--muted);
      }

      /* ---------------- Editor ---------------- */
      .editor {
        position: fixed;
        inset: 0;
        z-index: 60;
      }

      .editor__scrim {
        position: absolute;
        inset: 0;
        background: rgba(26, 21, 18, 0.4);
        border: 0;
        cursor: pointer;
      }

      .editor__panel {
        /* Pinned to the fixed parent rather than laid out as a grid item.
           As a grid item the row auto-sized to the content, so on a tall
           form the panel grew past the viewport and height:100% resolved
           against that overgrown row — leaving the body unconstrained and
           unscrollable however its overflow was set. */
        position: absolute;
        inset: 0 0 0 auto;
        width: min(520px, 100vw);
        display: grid;
        grid-template-rows: auto 1fr auto;
        background: var(--paper);
        border-left: 1px solid var(--line);
        box-shadow: var(--shadow-lift);
      }

      .editor__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-s);
        padding: var(--space-m);
        border-bottom: 1px solid var(--line);
      }

      .editor__title {
        font-size: var(--step-1);
        font-weight: 600;
      }

      .editor__close {
        background: none;
        border: 0;
        font-size: 1.6rem;
        line-height: 1;
        color: var(--muted);
        cursor: pointer;
        padding: 0 0.25rem;
      }

      .editor__close:hover {
        color: var(--ink);
      }

      .editor__body {
        overflow-y: auto;
        /* Without this the panel does not scroll. A grid item's automatic
           minimum size is its content, so this 1fr track grew to fit every
           field instead of capping at the panel height — overflow-y had
           nothing to overflow, the price fields sat below the fold, and the
           footer with Save was pushed off-screen entirely. */
        min-height: 0;
        overscroll-behavior: contain;
        padding: var(--space-m);
        display: grid;
        gap: var(--space-s);
        align-content: start;
      }

      .editor__foot {
        display: flex;
        justify-content: space-between;
        gap: var(--space-s);
        padding: var(--space-m);
        border-top: 1px solid var(--line);
      }

      .grid2 {
        display: grid;
        gap: var(--space-s);
      }

      @media (min-width: 420px) {
        .grid2 {
          grid-template-columns: 1fr 1fr;
        }
      }

      .field {
        display: grid;
        gap: var(--space-3xs);
      }

      .field input,
      .field select,
      .field textarea {
        font-family: inherit;
        font-size: var(--step-0);
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        background: var(--white);
        color: var(--ink);
        width: 100%;
      }

      .field textarea {
        resize: vertical;
        line-height: 1.5;
      }

      .field input:focus,
      .field select:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--oxblood-700);
        box-shadow: 0 0 0 3px var(--oxblood-050);
      }

      .field__hint {
        font-size: var(--step--1);
        color: var(--muted-light);
      }

      /* image picker */
      .imagebox {
        display: grid;
        gap: var(--space-2xs);
        padding: var(--space-s);
        border: 1px dashed var(--line);
        border-radius: var(--radius-sm);
        background: var(--white);
        justify-items: center;
      }

      .imagebox img {
        max-height: 120px;
        max-width: 100%;
        object-fit: contain;
        mix-blend-mode: multiply;
      }

      .imagebox__none {
        font-size: var(--step--1);
        color: var(--muted-light);
        padding-block: var(--space-m);
      }

      .imagebox__actions {
        display: flex;
        gap: var(--space-2xs);
        flex-wrap: wrap;
        justify-content: center;
      }

      .imagebox__path {
        font-size: var(--step--1);
        color: var(--muted);
        word-break: break-all;
        text-align: center;
      }

      /* buttons */
      .btn--ghost {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--ink);
        font-size: var(--step--1);
        padding: 0.55em 0.9em;
      }

      .btn--ghost:hover {
        border-color: var(--ink);
      }

      .btn--danger {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--oxblood-600);
        font-size: var(--step--1);
        padding: 0.55em 0.9em;
      }

      .btn--danger:hover {
        border-color: var(--oxblood-600);
        background: var(--oxblood-050);
      }

      .btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
    </style>
  </body>
</html>
