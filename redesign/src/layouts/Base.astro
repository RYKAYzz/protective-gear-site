---
import "@fontsource-variable/source-sans-3";
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingContact from "../components/FloatingContact.astro";
import { googleAdsTags, conversions } from "../data/conversions.js";
import { site } from "../data/site.js";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Google tag — Ads measurement. Two accounts advertise this site, so there
// may be more than one id; src/data/conversions.js is the source of truth.
// gtag.js itself only needs loading once, with any one of them.
const GTAG_SRC_ID = googleAdsTags[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        name: "ARK Hygiene Solutions",
        description:
          "ISO 13485 certified supplier of personal protective equipment, sterilization systems and medical waste equipment to healthcare facilities across Kenya.",
        url: "https://arkhygienesolutions.com",
        telephone: site.phones.map((line) => line.href.replace("tel:", "")),
        email: "arkhygieneexperts@gmail.com",
        foundingDate: "2018",
        address: {
          "@type": "PostalAddress",
          streetAddress: "Tumaini House, Room 310, CBD",
          addressLocality: "Nairobi",
          addressCountry: "KE",
        },
      })}
    />

    <!-- Google tag (gtag.js) -->
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_SRC_ID}`}></script>
    <script is:inline define:vars={{ googleAdsTags, conversions }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      // One config call per account, or the second account sees nothing.
      googleAdsTags.forEach(function (id) {
        gtag("config", id);
      });

      // Fires one conversion action. Each action carries the full send_to
      // values ("AW-<account>/<label>"), so an action can report into both
      // accounts at once. An empty list means the action has not been
      // created in Google Ads yet, so we stay silent rather than sending a
      // malformed hit.
      window.arkConversion = function (sendTo) {
        if (!sendTo || !sendTo.length) return;
        sendTo.forEach(function (value) {
          gtag("event", "conversion", { send_to: value });
        });
      };

      // Calls and WhatsApp messages are the two ways a buyer reaches us
      // without ever touching the quote form, and the phone number appears
      // in the header, the footer, the floating button and most page feet.
      // One delegated listener catches every one of them, including any
      // added later, instead of an onclick per link.
      document.addEventListener("click", function (event) {
        var link = event.target.closest && event.target.closest("a[href]");
        if (!link) return;
        var href = link.getAttribute("href") || "";
        if (href.lastIndexOf("tel:", 0) === 0) {
          window.arkConversion(conversions.callClick);
        } else if (href.indexOf("wa.me") !== -1) {
          window.arkConversion(conversions.whatsappClick);
        }
      });
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContact />

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: var(--space-xs) var(--space-s);
        z-index: 100;
      }
      .skip-link:focus {
        left: var(--space-s);
        top: var(--space-s);
      }
    </style>
  </body>
</html>
