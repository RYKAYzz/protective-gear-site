---
interface Props {
  name: string;
  detail?: string | null;
  image: string;
  price?: number | null;
  unit?: string | null;
}

const { name, detail, image, price, unit } = Astro.props;

// Prices are optional: most lines are quoted rather than listed, so a card
// simply omits the line when no price is set in the admin.
//
// Shown as "From KSh X per box" because these are unit prices that fall with
// volume, and a figure without its unit is ambiguous — a buyer needs to know
// whether that is a piece, a pair or a carton before it means anything.
const hasPrice = typeof price === "number" && price > 0;
const priceValue = hasPrice ? price.toLocaleString("en-KE") : null;
const unitLabel = unit && unit.trim() ? unit.trim() : null;
---

<article class="product">
  <div class="product__media">
    <img src={encodeURI(image)} alt={name} loading="lazy" decoding="async" />
  </div>
  <div class="product__body">
    <h3 class="product__name">{name}</h3>
    {detail && <p class="product__detail body-muted">{detail}</p>}
    {
      hasPrice && (
        <p class="product__price">
          <span class="product__price-from">From</span> KSh {priceValue}
          {unitLabel && <span class="product__price-unit">per {unitLabel}</span>}
        </p>
      )
    }
  </div>
</article>

<style>
  /* Fixed media height keeps every card in a row aligned regardless of the
     source image's aspect ratio. */
  /* A warm tinted field rather than a white box: the product sits in the
     brand world, and small source images read as placed rather than lost
     in empty white. */
  .product__media {
    position: relative;
    background: linear-gradient(
      165deg,
      var(--gold-050) 0%,
      var(--surface) 62%,
      #ece3d7 100%
    );
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    height: 280px;
    display: grid;
    place-items: center;
    padding: var(--space-m);
    /* Confines the image's multiply blend to this box. Without it the blend
       group reaches all the way up to the root, so the browser has to treat
       the page behind every one of the 70-odd cards as the backdrop it
       blends against. */
    isolation: isolate;
    transition: transform 0.35s var(--ease);
  }

  /* The lift shadow lives on a pseudo-element and fades in via opacity.
     Transitioning box-shadow itself repaints the card on every frame of the
     animation, and with a mouse crossing a grid of cards while scrolling
     that is a continuous stream of repaints. Opacity and transform are
     handled by the compositor and cost nothing per frame. */
  .product__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }

  /* Hover-only: on touch screens these states stick after a tap and buy
     nothing. */
  @media (hover: hover) {
    .product:hover .product__media {
      transform: translateY(-4px);
    }

    .product:hover .product__media::after {
      opacity: 1;
    }
  }

  /* Source images are small (max ~295px). Cap the rendered size at native
     resolution so they stay sharp rather than upscaled and soft. */
  .product__media img {
    width: auto;
    height: auto;
    max-width: min(100%, 180px);
    max-height: 210px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product__body {
    margin-top: var(--space-s);
  }

  .product__name {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .product__detail {
    font-size: var(--step--1);
    margin-top: 2px;
    max-width: 40ch;
  }

  .product__price {
    margin-top: var(--space-2xs);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--oxblood-700);
    font-variant-numeric: tabular-nums;
  }

  /* "From" and the unit sit quieter than the figure they qualify */
  .product__price-from {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product__price-unit {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
    margin-left: 0.15em;
  }
</style>
