---
interface Props {
  name: string;
  detail?: string | null;
  image: string;
  price?: number | null;
}

const { name, detail, image, price } = Astro.props;

// Prices are optional: most lines are quoted rather than listed, so a card
// simply omits the line when no price is set in the admin.
const priceLabel =
  typeof price === "number" && price > 0
    ? `KES ${price.toLocaleString("en-KE")}`
    : null;
---

<article class="product">
  <div class="product__media">
    <img src={encodeURI(image)} alt={name} loading="lazy" decoding="async" />
  </div>
  <div class="product__body">
    <h3 class="product__name">{name}</h3>
    {detail && <p class="product__detail body-muted">{detail}</p>}
    {priceLabel && <p class="product__price">{priceLabel}</p>}
  </div>
</article>

<style>
  /* Fixed media height keeps every card in a row aligned regardless of the
     source image's aspect ratio. */
  /* A warm tinted field rather than a white box: the product sits in the
     brand world, and small source images read as placed rather than lost
     in empty white. */
  .product__media {
    background: linear-gradient(
      165deg,
      var(--gold-050) 0%,
      var(--surface) 62%,
      #ece3d7 100%
    );
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    height: 280px;
    display: grid;
    place-items: center;
    padding: var(--space-m);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .product:hover .product__media {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  /* Source images are small (max ~295px). Cap the rendered size at native
     resolution so they stay sharp rather than upscaled and soft. */
  .product__media img {
    width: auto;
    height: auto;
    max-width: min(100%, 180px);
    max-height: 210px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product__body {
    margin-top: var(--space-s);
  }

  .product__name {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .product__detail {
    font-size: var(--step--1);
    margin-top: 2px;
    max-width: 40ch;
  }

  .product__price {
    margin-top: var(--space-2xs);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--oxblood-700);
    font-variant-numeric: tabular-nums;
  }
</style>
