---
interface Props {
  name: string;
  detail?: string | null;
  image: string;
  price?: number | null;
  unit?: string | null;
}

import { productEnquiry } from "../data/enquiry.js";

const { name, detail, image, price, unit } = Astro.props;

// The page the buyer is on, absolute, so the message is useful when staff
// open it on a different device.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const askHref = productEnquiry({ name, price, unit, url: pageUrl });

// Prices are optional: most lines are quoted rather than listed, so a card
// simply omits the line when no price is set in the admin.
//
// Shown as "From KSh X per box" because these are unit prices that fall with
// volume, and a figure without its unit is ambiguous — a buyer needs to know
// whether that is a piece, a pair or a carton before it means anything.
const hasPrice = typeof price === "number" && price > 0;
const priceValue = hasPrice ? price.toLocaleString("en-KE") : null;
const unitLabel = unit && unit.trim() ? unit.trim() : null;
---

<article class="product">
  <div class="product__media">
    <img src={encodeURI(image)} alt={name} loading="lazy" decoding="async" />
  </div>
  <div class="product__body">
    <h3 class="product__name">{name}</h3>
    {/* Rendered even when empty. The CSS reserves two lines here, so a
        product without a description keeps its price and action at the same
        height as every other card in the row. */}
    <p class="product__detail body-muted">{detail}</p>
    {
      hasPrice && (
        <p class="product__price">
          <span class="product__price-from">From</span> KSh {priceValue}
          {unitLabel && <span class="product__price-unit">per {unitLabel}</span>}
        </p>
      )
    }

    <a
      class="product__ask"
      href={askHref}
      target="_blank"
      rel="noopener"
      aria-label={`Enquire about ${name} on WhatsApp`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.25-4.36c0-4.54 3.7-8.23 8.24-8.23a8.17 8.17 0 0 1 5.82 2.42 8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.21-8.25 8.21Z"
        ></path>
        <path
          fill="currentColor"
          d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"
        ></path>
      </svg>
      Ask on WhatsApp
    </a>
  </div>
</article>

<style>
  /* Fixed media height keeps every card in a row aligned regardless of the
     source image's aspect ratio. */
  /* A warm tinted field rather than a white box: the product sits in the
     brand world, and small source images read as placed rather than lost
     in empty white. */
  .product__media {
    position: relative;
    background: linear-gradient(
      165deg,
      var(--gold-050) 0%,
      var(--surface) 62%,
      #ece3d7 100%
    );
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    height: 280px;
    display: grid;
    place-items: center;
    padding: var(--space-m);
    /* Confines the image's multiply blend to this box. Without it the blend
       group reaches all the way up to the root, so the browser has to treat
       the page behind every one of the 70-odd cards as the backdrop it
       blends against. */
    isolation: isolate;
    transition: transform 0.35s var(--ease);
  }

  /* The lift shadow lives on a pseudo-element and fades in via opacity.
     Transitioning box-shadow itself repaints the card on every frame of the
     animation, and with a mouse crossing a grid of cards while scrolling
     that is a continuous stream of repaints. Opacity and transform are
     handled by the compositor and cost nothing per frame. */
  .product__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--shadow-lift);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease);
  }

  /* Hover-only: on touch screens these states stick after a tap and buy
     nothing. */
  @media (hover: hover) {
    .product:hover .product__media {
      transform: translateY(-4px);
    }

    .product:hover .product__media::after {
      opacity: 1;
    }
  }

  /* Source images are small (max ~295px). Cap the rendered size at native
     resolution so they stay sharp rather than upscaled and soft. */
  .product__media img {
    width: auto;
    height: auto;
    max-width: min(100%, 180px);
    max-height: 210px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* Column layout so the enquiry action can be pushed to the bottom of every
     card. Names wrap to one or two lines and only some cards carry a price,
     so without this the buttons sit at a different height in every card of
     a row and the grid reads as ragged. */
  .product {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product__body {
    margin-top: var(--space-s);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Names run from two words to seven and descriptions from nothing to 163
     characters, so left to themselves every card in a row starts its price
     at a different height and the grid reads as ragged rather than as a
     catalogue. Each text block is therefore clamped to a fixed number of
     lines AND floored at the same number: the clamp stops long copy pushing
     the card down, the floor stops short copy pulling it up. Two lines each
     covers the median description comfortably. */
  .product__name {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: 2.5em; /* 2 lines x 1.25 */
  }

  .product__detail {
    font-size: var(--step--1);
    margin-top: 2px;
    max-width: 40ch;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: 3em; /* 2 lines x 1.5 */
  }

  .product__price {
    margin-top: var(--space-2xs);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--oxblood-700);
    font-variant-numeric: tabular-nums;
  }

  /* Understated by default — a grid of 70 cards with a saturated green
     button in each would be a wall of noise, and the brand does not shout.
     It reads as a quiet affordance until the card is hovered, which is when
     the buyer has chosen something. margin-top:auto pins it to the bottom
     regardless of how much text sits above. */
  .product__ask {
    margin-top: auto;
    padding-top: var(--space-s);
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    align-self: start;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }

  .product__ask svg {
    width: 1.05em;
    height: 1.05em;
    flex: none;
    color: #25d366;
    opacity: 0.85;
    transition: opacity 0.2s var(--ease);
  }

  .product:hover .product__ask,
  .product__ask:hover,
  .product__ask:focus-visible {
    color: var(--oxblood-700);
  }

  .product:hover .product__ask svg,
  .product__ask:hover svg {
    opacity: 1;
  }

  /* "From" and the unit sit quieter than the figure they qualify */
  .product__price-from {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product__price-unit {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
    margin-left: 0.15em;
  }
</style>
