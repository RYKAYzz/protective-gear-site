---
import { categories } from "../data/categories.js";
---

{/*
  Posts to /api/quote, which emails the enquiry. Netlify Forms used to
  handle this, but it is Netlify-only — this works on any host.

  The action and method are real, so a browser with JavaScript disabled
  still submits; the script below upgrades it to stay on the page.
*/}
<form
  class="quote-form"
  id="quote-form"
  name="quote"
  method="POST"
  action="/api/quote"
>

  {/* honeypot: hidden from people, tempting to bots */}
  <p class="hp">
    <label>
      Do not fill this in
      <input name="company-website" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="field-row">
    <p class="field">
      <label for="q-name">Name <span aria-hidden="true">*</span></label>
      <input id="q-name" name="name" type="text" required autocomplete="name" />
    </p>
    <p class="field">
      <label for="q-org">Facility or organisation</label>
      <input
        id="q-org"
        name="organisation"
        type="text"
        autocomplete="organization"
      />
    </p>
  </div>

  <div class="field-row">
    <p class="field">
      <label for="q-email">Email <span aria-hidden="true">*</span></label>
      <input
        id="q-email"
        name="email"
        type="email"
        required
        autocomplete="email"
      />
    </p>
    <p class="field">
      <label for="q-phone">Phone</label>
      <input id="q-phone" name="phone" type="tel" autocomplete="tel" />
    </p>
  </div>

  <p class="field">
    <label for="q-category">Product area</label>
    <select id="q-category" name="category">
      <option value="">Not sure yet</option>
      {categories.map((c) => <option value={c.name}>{c.name}</option>)}
      <option value="Multiple / other">Multiple or other</option>
    </select>
  </p>

  <p class="field">
    <label for="q-message">
      What do you need? <span aria-hidden="true">*</span>
    </label>
    <textarea
      id="q-message"
      name="message"
      rows="5"
      required
      placeholder="List the items and quantities, e.g. 20 boxes examination gloves (M), 500 face masks, 1 autoclave."></textarea>
  </p>

  <div class="form-foot">
    <button type="submit" class="btn btn--primary" id="quote-submit">
      Send request
    </button>
    <p class="form-note body-muted">We reply within 24 hours.</p>
  </div>

  <p class="form-result" id="quote-result" role="alert" hidden></p>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById("quote-form");
    if (!form) return;
    var btn = document.getElementById("quote-submit");
    var out = document.getElementById("quote-result");

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      out.hidden = true;
      out.removeAttribute("data-tone");
      btn.disabled = true;
      btn.textContent = "Sending…";

      try {
        var res = await fetch("/api/quote", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(
            Object.fromEntries(new FormData(form).entries())
          ),
        });
        var data = await res.json().catch(function () {
          return {};
        });

        if (!res.ok) throw new Error(data.error || "Something went wrong.");

        window.location.href = "/thank-you";
        return;
      } catch (err) {
        // Never strand a lead: give them the phone number rather than a dead end.
        out.textContent = err.message;
        out.setAttribute("data-tone", "err");
        out.hidden = false;
        btn.disabled = false;
        btn.textContent = "Send request";
      }
    });
  })();
</script>

<style>
  .quote-form {
    display: grid;
    gap: var(--space-m);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field-row {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 620px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
  }

  label {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  label span {
    color: var(--oxblood-600);
  }

  input,
  select,
  textarea {
    font-family: inherit;
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.85rem;
    width: 100%;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  textarea {
    resize: vertical;
    line-height: 1.6;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--oxblood-700);
    box-shadow: 0 0 0 3px var(--oxblood-050);
  }

  ::placeholder {
    color: var(--muted-light);
  }

  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-2xs);
  }

  .form-note {
    font-size: var(--step--1);
    margin: 0;
  }

  .form-result {
    margin: var(--space-s) 0 0;
    padding: var(--space-2xs) var(--space-xs);
    font-size: var(--step--1);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-soft);
  }

  .form-result[data-tone="err"] {
    background: var(--oxblood-050);
    color: var(--oxblood-800);
  }
</style>
