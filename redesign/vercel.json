{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "trailingSlash": false,

  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },

    {
      "source": "/ppe-safety-gear.html",
      "destination": "/ppe-safety-gear",
      "permanent": true
    },
    {
      "source": "/sterilization-waste-equipment.html",
      "destination": "/sterilization-waste-equipment",
      "permanent": true
    },
    {
      "source": "/sanitary-solutions.html",
      "destination": "/sanitary-solutions",
      "permanent": true
    },
    {
      "source": "/spill-management.html",
      "destination": "/spill-management",
      "permanent": true
    },
    {
      "source": "/public-health-sanitation.html",
      "destination": "/public-health-sanitation",
      "permanent": true
    },
    {
      "source": "/medical-equipment.html",
      "destination": "/medical-equipment",
      "permanent": true
    },
    {
      "source": "/selected-products.html",
      "destination": "/products",
      "permanent": true
    },

    { "source": "/about-us.html", "destination": "/about", "permanent": true },
    {
      "source": "/services.html",
      "destination": "/capabilities",
      "permanent": true
    },
    {
      "source": "/contact-us.html",
      "destination": "/contact",
      "permanent": true
    },
    { "source": "/faq.html", "destination": "/faq", "permanent": true },
    {
      "source": "/testimonials.html",
      "destination": "/testimonials",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-of-service.html",
      "destination": "/terms-of-service",
      "permanent": true
    },

    { "source": "/blog.html", "destination": "/products", "permanent": false },
    {
      "source": "/blog-articles/:path*",
      "destination": "/products",
      "permanent": false
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
